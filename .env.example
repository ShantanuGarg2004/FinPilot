# Required
GROQ_API_KEY=your-groq-api-key
API_SECRET_KEY=your-chosen-api-secret

# Optional model overrides
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_REPORT_MAX_TOKENS=4096
GROQ_CHAT_MAX_TOKENS=1500

# Rate limiting — Wave 0 Flask-Limiter (fallback) + Wave 1 SQL store
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STORAGE_BACKEND=sql
RATELIMIT_DATABASE_URL=postgresql+psycopg://finpilot:finpilot_dev_password@127.0.0.1:5432/finpilot_ratelimit
# Optional quota overrides (parsed by the limits package). PDF rebuild is separate from GET /report.
# RATELIMIT_READ=120 per minute
# RATELIMIT_PDF_REBUILD=5 per minute

# development | production (affects default read rate ceilings and whether Swagger is on)
FLASK_ENV=development

# Q5 — required only when finance.db already has profiles with no account.
# The password is hashed on startup. It is the bootstrap person's login.
# BOOTSTRAP_ACCOUNT_EMAIL=you@example.com
# BOOTSTRAP_ACCOUNT_PASSWORD=choose-a-long-password

# Q4 — browser origins allowed to call /api. Comma-separated. Unset means local Vite only.
# An empty list is rejected when FLASK_ENV is not development/dev/local.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Wave 3 — worker sizing and timeouts (worker timeout must exceed Groq timeout)
GROQ_TIMEOUT_SECONDS=90
WORKER_TIMEOUT_SECONDS=120
PEAK_CONCURRENT_LLM=4
WORKER_HEADROOM=2
SQLITE_BUSY_TIMEOUT_MS=5000

# Q3 — local directory for advisory PDFs (not S3). Override if the process cwd differs.
# PDF_STORAGE_DIR=data/pdfs
